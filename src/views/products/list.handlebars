<h1>Products</h1>

<a href="/api/products/new/form">Add New Product</a>
<ul>
  {{#each products}}
    <li>
      <h2>{{title}}</h2>
      <p>{{description}}</p>
      <p>Price: ${{price}}</p>
      <p>Stock: {{stock}}</p>
      <p>Category: {{category}}</p>

      <a href="/products/{{_id}}">view details</a>

      <a href="/api/products/edit/{{_id}}">Edit</a>

      <form action="/api/products/{{_id}}?_method=DELETE" method="POST">
        <button type="submit">Delete</button>
      </form>
    </li>

    <form
      action="/api/carts/6a19017b956612a7ba3862f9/products/{{_id}}"
      method="POST"
    >
      <button type="submit">Add to Cart</button>
    </form>
  {{/each}}
</ul>